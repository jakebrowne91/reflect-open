# https://github.com/kanbn/kan?tab=readme-ov-file#environment-variables-)

# Required environment variables
NEXT_PUBLIC_BASE_URL= # e.g. https://kan.bn
NEXT_PUBLIC_RETROGRADE_ADMIN_APP_URL=https://admin.creatorcomputecompany.com/gsd
BETTER_AUTH_SECRET= # Random 32+ char string (can gen with: openssl rand -base64 26 | tr -dc 'a-zA-Z0-9' | head -c 32)
RETROGRADE_GSD_SSO_SECRET= # Shared secret used by Retrograde admin SSO
RETROGRADE_GSD_API_SECRET= # Shared HMAC secret used by Ari/Emma to create support tickets
INTERNAL_CALLBACK_SECRET= # Shared HMAC secret used by GSD to post Slack support alerts
RETROGRADE_SLACK_BOT_CALLBACK_URL= # e.g. https://slack-bot.example.workers.dev
RETROGRADE_SUPPORT_WORKSPACE_SLUG=retrograde-support
RETROGRADE_SUPPORT_WORKSPACE_NAME=Creator Compute Company Support
ARI_GOLD_EXTERNAL_AGENT_WEBHOOK_URL=https://agent-webhook-ari-gold.retrogradeai.workers.dev/webhooks/external-agent
ARI_GOLD_EXTERNAL_AGENT_WEBHOOK_SECRET= # Shared HMAC secret used by GSD to launch Ari and receive callbacks
ARI_GOLD_DEFAULT_REPO=creatorcomputecompany/emma
ARI_GOLD_DEFAULT_MODEL=openai/gpt-5.6-luna
ARI_GOLD_DEFAULT_REASONING_EFFORT=high
ARI_GOLD_DEFAULT_CODING_AGENT=pi
OPENAI_API_KEY= # Used by GSD to generate concise support card titles
GSD_TICKET_TITLE_MODEL=gpt-5.5
RETROGRADE_SUPPORT_BOARD_SLUG=customer-support
RETROGRADE_SUPPORT_BOARD_NAME=Customer Support

# Fill if you want to use an external database
POSTGRES_URL= # e.g. postgresql://kan:your_password@your_host:5432/kan
POSTGRES_POOL_MAX=5
POSTGRES_SSL= # set to "true" to force TLS or "false" to disable it
POSTGRES_SSL_REJECT_UNAUTHORIZED= # set to "true" to verify custom CA chains

# Only required if deploying from compose
POSTGRES_PASSWORD=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM= # e.g. "Kan <hello@mail.kan.bn>"
SMTP_SECURE= # set to "false" to use port 587
SMTP_REJECT_UNAUTHORIZED= # set to "false" to accept invalid certs

# Switch email features off entirely (optional)
NEXT_PUBLIC_DISABLE_EMAIL=

# S3 storage (optional)
S3_REGION= # copy from Supabase Storage S3 settings
S3_ENDPOINT= # e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# S3_AVATAR_UPLOAD_LIMIT=2097152 # Avatar upload size limit in bytes (default: 2MB)
NEXT_PUBLIC_STORAGE_URL= # e.g. https://<project-ref>.storage.supabase.co/storage/v1/object/public
NEXT_PUBLIC_AVATAR_BUCKET_NAME=gsd-avatars
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=gsd-attachments
NEXT_PUBLIC_STORAGE_DOMAIN= # e.g. <project-ref>.storage.supabase.co
NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=false


# Auth config (optional)
NEXT_PUBLIC_ALLOW_CREDENTIALS=
NEXT_PUBLIC_DISABLE_SIGN_UP=

# API configuration (optional)
NEXT_API_BODY_SIZE_LIMIT= # e.g. 50mb (defaults to 1mb)

# Integration providers (optional)
TRELLO_APP_API_KEY=
TRELLO_APP_SECRET=

# Superset coding agent integration (optional)
# Create the API key in Superset Settings > API Keys. Keep it server-side only.
SUPERSET_API_KEY=
SUPERSET_ORGANIZATION_ID=
SUPERSET_AGENT=codex
# Optional. If empty, the first online Superset host in the org is used.
SUPERSET_HOST_ID=
SUPERSET_PROJECT_ID=
# Optional JSON agent config. Useful while the Superset SDK agent shorthand is alpha.
SUPERSET_AGENT_CONFIG_JSON=

# Redis (optional - for rate limiting)
# If not provided, rate limiting will use in-memory storage
REDIS_URL= # e.g. redis://default:your_password@your_host:6379

# Logging (optional - debug, info, warn, error; defaults to debug in dev, info in prod)
LOG_LEVEL=

# OAuth providers (optional)
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional: Restrict OIDC/Social sign-ins to specific email domains (comma-separated)
BETTER_AUTH_ALLOWED_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
